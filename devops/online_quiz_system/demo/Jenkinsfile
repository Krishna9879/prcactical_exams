pipeline {
    agent any

    environment {
        MVN_CMD = './mvnw'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('demo') {
                    sh "${env.MVN_CMD} clean compile"
                }
            }
        }

        stage('Test') {
            steps {
                dir('demo') {
                    sh "${env.MVN_CMD} test"
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'demo/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            steps {
                dir('demo') {
                    sh "${env.MVN_CMD} package -DskipTests"
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'demo/target/*.war', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Jenkins pipeline completed successfully.'
        }
        failure {
            echo 'Jenkins pipeline failed. Check the console output for details.'
        }
    }
}
